{
  "openapi": "3.1.0",
  "info": {
    "title": "Pizza Luna Ordering API",
    "version": "1.0.0",
    "description": "Public contract of the Pizza Luna ordering API. Source for the generated API reference and the frontend client."
  },
  "servers": [{ "url": "https://api.pizzaluna.example" }],
  "tags": [
    { "name": "Branches", "description": "Branches, opening hours and delivery zones" },
    { "name": "Menu", "description": "Menu items and their availability per branch" },
    { "name": "Orders", "description": "Placing, tracking and cancelling orders" }
  ],
  "paths": {
    "/api/branches": {
      "get": {
        "tags": ["Branches"],
        "summary": "List all branches",
        "operationId": "listBranches",
        "responses": {
          "200": {
            "description": "All branches with opening hours and pause state.",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Branch" } } } }
          }
        }
      }
    },
    "/api/menu": {
      "get": {
        "tags": ["Menu"],
        "summary": "Get the menu for a branch",
        "operationId": "getMenu",
        "parameters": [
          { "name": "branch", "in": "query", "required": true, "description": "Branch code, for example OT.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Menu items with availability in the requested branch.",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MenuItem" } } } }
          },
          "404": { "description": "Unknown branch code." }
        }
      }
    },
    "/api/orders": {
      "post": {
        "tags": ["Orders"],
        "summary": "Place an order",
        "description": "Validates the order and queues it for processing. Payment is authorised asynchronously; the order starts in status Placed.",
        "operationId": "placeOrder",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlaceOrderRequest" } } }
        },
        "responses": {
          "202": {
            "description": "Order accepted for processing.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } }
          },
          "400": { "description": "Invalid order, for example below the minimum value for delivery." },
          "409": { "description": "Branch closed, closing within 30 minutes, or paused." }
        }
      }
    },
    "/api/orders/{orderNumber}": {
      "get": {
        "tags": ["Orders"],
        "summary": "Get an order",
        "operationId": "getOrder",
        "parameters": [
          { "name": "orderNumber", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "token", "in": "query", "required": true, "description": "Tracking token from the confirmation email.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The order.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "404": { "description": "Unknown order or invalid token." }
        }
      }
    },
    "/api/orders/{orderNumber}/cancel": {
      "post": {
        "tags": ["Orders"],
        "summary": "Cancel an order",
        "description": "Customers can cancel until the order is InOven.",
        "operationId": "cancelOrder",
        "parameters": [
          { "name": "orderNumber", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "token", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Order cancelled.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "409": { "description": "Order can no longer be cancelled." }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Branch": {
        "type": "object",
        "required": ["code", "name", "deliveryAvailable", "isPaused"],
        "properties": {
          "code": { "type": "string", "examples": ["OT"] },
          "name": { "type": "string", "examples": ["Old Town"] },
          "deliveryAvailable": { "type": "boolean" },
          "isPaused": { "type": "boolean", "description": "True while the branch has paused online orders." }
        }
      },
      "MenuItem": {
        "type": "object",
        "required": ["id", "name", "category", "basePrice", "isAvailable"],
        "properties": {
          "id": { "type": "string", "examples": ["margherita"] },
          "name": { "type": "string", "examples": ["Margherita"] },
          "category": { "type": "string", "enum": ["Pizza", "Drink", "Side"] },
          "basePrice": { "type": "number", "description": "Price of the regular size in EUR including VAT.", "examples": [8.5] },
          "isAvailable": { "type": "boolean" }
        }
      },
      "OrderLine": {
        "type": "object",
        "required": ["menuItemId", "quantity"],
        "properties": {
          "menuItemId": { "type": "string" },
          "size": { "type": "string", "enum": ["Regular", "Large"], "default": "Regular" },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 20 },
          "toppings": { "type": "array", "maxItems": 5, "items": { "type": "string" } }
        }
      },
      "PlaceOrderRequest": {
        "type": "object",
        "required": ["fulfilmentType", "customer", "lines"],
        "properties": {
          "fulfilmentType": { "type": "string", "enum": ["Pickup", "Delivery"] },
          "branchCode": { "type": "string", "description": "Required for pickup. Derived from the postal code for delivery." },
          "customer": {
            "type": "object",
            "required": ["name", "email"],
            "properties": {
              "name": { "type": "string" },
              "email": { "type": "string", "format": "email" },
              "address": { "type": "string", "description": "Required for delivery." },
              "postalCode": { "type": "string", "description": "Required for delivery." }
            }
          },
          "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/OrderLine" } },
          "tip": { "type": "number", "minimum": 0, "maximum": 10, "description": "Optional tip for the delivery driver in EUR. Only allowed for delivery orders." }
        }
      },
      "Order": {
        "type": "object",
        "required": ["orderNumber", "branchCode", "status", "fulfilmentType", "total", "placedAt"],
        "properties": {
          "orderNumber": { "type": "string", "examples": ["HB-0427"] },
          "branchCode": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["Placed", "Accepted", "Rejected", "InOven", "ReadyForPickup", "OutForDelivery", "Completed", "Cancelled"]
          },
          "fulfilmentType": { "type": "string", "enum": ["Pickup", "Delivery"] },
          "lines": { "type": "array", "items": { "$ref": "#/components/schemas/OrderLine" } },
          "deliveryFee": { "type": "number" },
          "tip": { "type": "number", "description": "Tip for the delivery driver in EUR. Paid out to the branch's drivers." },
          "total": { "type": "number", "description": "Sum of line totals plus delivery fee and tip in EUR including VAT." },
          "placedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
