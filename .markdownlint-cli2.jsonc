{
  // markdownlint rules: https://github.com/DavidAnson/markdownlint
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": { "allowed_elements": ["br"] },
    // Pages take their title from front matter; PR templates and prompt files start without one.
    "MD041": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "website/build/**",
    "website/.docusaurus/**",
    "docs/development/reference/api.md",
    ".vale/styles/**"
  ]
}
