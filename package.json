{
  "name": "pizza-luna-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Documentation as Code demo for the Pizza Luna ordering platform.",
  "scripts": {
    "lint:docs": "node scripts/lint-docs.mjs",
    "lint:md": "markdownlint-cli2",
    "lint:spelling": "cspell --no-progress --show-suggestions \"docs/**/*.md\" \"*.md\" \".github/**/*.md\"",
    "lint:structure": "node scripts/check-docs.mjs",
    "lint:style": "vale docs",
    "lint:links": "lychee --config lychee.toml docs \"*.md\"",
    "docs:generate": "node scripts/generate-api-reference.mjs",
    "docs:start": "npm run docs:generate && docusaurus start src/DeveloperPortal",
    "docs:build": "npm run docs:generate && docusaurus build src/DeveloperPortal",
    "docs:clear": "docusaurus clear src/DeveloperPortal"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "cspell": "^9.1.0",
    "markdownlint-cli2": "^0.18.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "browserslist": {
    "production": [">0.5%", "not dead", "not op_mini all"],
    "development": ["last 3 chrome version", "last 3 firefox version", "last 5 safari version"]
  },
  "engines": {
    "node": ">=22"
  }
}
